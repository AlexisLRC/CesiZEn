# .env.testing
APP_NAME=CESIZen
APP_ENV=testing
APP_KEY= # Laisse vide, la CI va le générer automatiquement
APP_DEBUG=true

# On utilise SQLite en mémoire pour que les tests soient ultra rapides
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# On désactive les caches et les envois de vrais emails pendant les tests
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array